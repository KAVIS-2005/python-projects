def studentdetails():
    std_name=input("Enter your name:")
    roll_no=int(input("Enter your roll no:"))
    return std_name,roll_no
student_name,roll_number=studentdetails()

print("Student Name:",student_name)
print("Roll Number:",roll_number)


def studentmarks():
    marks=[]
    for i in range(3):
        mark=int(input("Enter you subject mark:"))
        marks.append(mark)
    return marks
student_marks=studentmarks()
print(student_marks)


    
    
def calculation_result(marks):
    total=0
    for mark in marks:
        total=total+mark
    average=total/3
    return total,average
totalmarks,averagemarks=calculation_result(student_marks)
print(totalmarks)
print(averagemarks)

def check_grade(marks, average):
    passed = True

    for mark in marks:
        if mark < 50:
            passed = False

    if passed == False:
        grade = "F"
        result = "Fail"

    elif average >= 90:
        grade = "A+"
        result = "Pass"

    elif average >= 80:
        grade = "A"
        result = "Pass"

    elif average >= 70:
        grade = "B"
        result = "Pass"

    elif average >= 60:
        grade = "C"
        result = "Pass"

    elif average >= 50:
        grade = "D"
        result = "Pass"

    else:
        grade = "F"
        result = "Fail"

    return grade, result
grade, result = check_grade(student_marks, averagemarks)

print("Grade:", grade)
print("Result:", result)

def display_report():
    print("=======STUDENT REPORT CARD==========")
    print("Name:", student_name)
    print("Roll No:", roll_number)
    print("Marks:", student_marks)
    print("Total:", totalmarks)
    print("Average:", round(averagemarks,2))
    print("Grade:", grade)
    print("Result:", result)
display_report()


while True:
